# Explicit opt-in for sending invoice fields to configured external providers.
# Leave false for local-only use and synthetic data.
ALLOW_EXTERNAL_FINANCE_DATA=false

# BAND names/handles must match the four remote agents you register in app.band.ai.
BAND_COORDINATOR_HANDLE=invoiceguard
BAND_POLICY_HANDLE=invoicepolicy
BAND_MEMORY_HANDLE=invoicememory
BAND_RESEARCH_HANDLE=invoiceresearch

# Superlinked SIE: leave both empty to require structured JSON in the BAND room.
# Local Apple Silicon generation: http://localhost:8081
# Local NVIDIA/Docker generation: http://localhost:8080
SIE_BASE_URL=
SIE_API_KEY=
SIE_MODEL=Qwen/Qwen3-0.6B

# Cognee: set a dedicated dataset for this one business workspace.
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_DATASET_NAME=

# Keenable: live web price research is off unless a key is configured.
KEENABLE_API_KEY=
